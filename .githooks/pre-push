#!/bin/bash
# Pre-push hook of the Gas Town repository itself (core.hooksPath=.githooks).
#
# 1. Block PRs by preventing pushes to arbitrary feature branches.
#    Gas Town agents push to main (crew) or polecat/* branches (polecats).
#    PRs are for external contributors only.
# 2. Refuse pushing a branch you are not standing on (HEAD-mismatch guard).
# 3. Integration landing + merge scope: delegated to `gt hooks pre-push`, the
#    single source of truth shared with the managed hook Gas Town installs in
#    rig repos (gt-pd1c.72). Agents (GT_ROLE/BD_ACTOR/GT_POLECAT/GT_CREW) may
#    not land while merge_queue.integration_branch_auto_land is off, whatever
#    GT_INTEGRATION_LAND says. The bash fallback below only runs when no gt
#    with `hooks pre-push` is on PATH; it is stricter for agents (no land, and
#    without the merge queue no agent other than crew may delete or rewrite
#    polecat/* unless its tip is archived under refs/gt/archive/* on the
#    remote, nor create, delete or rewrite an archive ref; gt-pd1c.78).
#
# Local hooks can be skipped by the pusher; protect the real remote with
# branch protection (docs/HOOKS.md, "Rig pre-push guard").

# Detect the rig's default branch dynamically.
# Fallback chain matches Go implementation (git.RemoteDefaultBranch):
# 1. origin/HEAD symref
# 2. origin/master (if it exists)
# 3. origin/main (final fallback)
default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's#refs/remotes/origin/##')
if [[ -z "$default_branch" ]]; then
  if git rev-parse --verify origin/master &>/dev/null; then
    default_branch=master
  else
    default_branch=main
  fi
fi

# Same identity variables as the Go guard (agentSessionEnvVars).
is_agent=0
for v in GT_ROLE BD_ACTOR GT_POLECAT GT_CREW; do
  val="${!v}"
  if [[ -n "${val//[[:space:]]/}" ]]; then
    is_agent=1
  fi
done

# Caller classification, the same as the Go guard (gtCallerFrom, gt-pd1c.78;
# internal/cmd/caller_identity_parity_test.go runs one env matrix on both).
# Every identity variable that is set makes a claim; conflicts are read the
# strictest way: the caller is exempt (human-equivalent) only when every claim
# is crew, or BD_ACTOR=overseer while GT_ROLE and GT_POLECAT are empty.
# Otherwise the role is the agent role the other claims agree on, or
# "conflicting-identity".

# parse_role mirrors parseRoleString: sets pr_role and pr_name (polecat name).
parse_role() {
  local s="$1"
  while [[ "$s" == *//* ]]; do s="${s//\/\//\/}"; done
  s="${s%/}"
  pr_name=""
  case "$s" in
    mayor|deacon|boot|dog) pr_role="$s"; return ;;
  esac
  local parts
  IFS='/' read -r -a parts <<< "$s"
  if (( ${#parts[@]} < 2 )); then
    pr_role="$s"
    return
  fi
  case "${parts[1]}" in
    boot)
      if [[ "${parts[0]}" == "deacon" && ${#parts[@]} -eq 2 ]]; then pr_role=boot; else pr_role="$s"; fi ;;
    witness) pr_role=witness ;;
    refinery) pr_role=refinery ;;
    polecats) pr_role=polecat; pr_name="${parts[2]:-}" ;;
    crew) pr_role=crew ;;
    *) pr_role=polecat; pr_name="${parts[1]}" ;;
  esac
}

c_roles=(); c_exempt=(); c_names=()
add_claim() { c_roles+=("$1"); c_exempt+=("$2"); c_names+=("$3"); }
gt_role_v="${GT_ROLE//[[:space:]]/}"
actor_v="${BD_ACTOR//[[:space:]]/}"
gt_polecat_v="${GT_POLECAT//[[:space:]]/}"
gt_crew_v="${GT_CREW//[[:space:]]/}"
if [[ -n "$gt_role_v" ]]; then
  parse_role "$gt_role_v"
  ex=0; [[ "$pr_role" == "crew" ]] && ex=1
  nm=""; [[ "$pr_role" == "polecat" ]] && nm="$pr_name"
  add_claim "$pr_role" "$ex" "$nm"
fi
if [[ -n "$actor_v" ]]; then
  if [[ "$actor_v" =~ ^[^/]+/polecats/[^/]+$ ]]; then
    add_claim polecat 0 "${actor_v##*/}"
  else
    parse_role "$actor_v"
    ex=0
    if [[ "$pr_role" == "crew" ]] || [[ "$pr_role" == "overseer" && -z "$gt_role_v" && -z "$gt_polecat_v" ]]; then
      ex=1
    fi
    nm=""; [[ "$pr_role" == "polecat" ]] && nm="$pr_name"
    add_claim "$pr_role" "$ex" "$nm"
  fi
fi
[[ -n "$gt_polecat_v" ]] && add_claim polecat 0 "$gt_polecat_v"
[[ -n "$gt_crew_v" ]] && add_claim crew 1 ""

caller_role=""; caller_name=""; is_exempt=1
if [[ "$is_agent" == "1" ]]; then
  exempt_role=crew; agent_seen=0
  for i in "${!c_roles[@]}"; do
    r="${c_roles[$i]}"; n="${c_names[$i]}"
    if [[ "${c_exempt[$i]}" == "1" ]]; then
      [[ "$r" == "overseer" ]] && exempt_role=overseer
      continue
    fi
    if [[ "$agent_seen" == "0" ]]; then
      agent_seen=1; caller_role="$r"; caller_name="$n"
    elif [[ "$r" != "$caller_role" ]]; then
      caller_role=conflicting-identity; caller_name=""
    elif [[ -n "$n" && -n "$caller_name" && "$n" != "$caller_name" ]]; then
      caller_role=conflicting-identity; caller_name=""
    elif [[ -z "$caller_name" ]]; then
      caller_name="$n"
    fi
  done
  if [[ "$agent_seen" == "0" ]]; then
    caller_role="$exempt_role"
  else
    is_exempt=0
  fi
fi

# owns_branch: the caller is the polecat whose branch this is (polecat/<name>,
# polecat/<name>/..., or polecat/<name>-<suffix>), as gtCaller.ownsPolecatBranch.
owns_branch() {
  local b="$1" rest
  [[ "$caller_role" == "polecat" && -n "$caller_name" ]] || return 1
  [[ "$b" == "polecat/$caller_name" || "$b" == "polecat/$caller_name/"* ]] && return 0
  rest="${b#polecat/}"
  [[ "$rest" != */* && "$rest" == *-* && "${rest%-*}" == "$caller_name" ]]
}

# tip_archived: an archive ref (refs/gt/archive/*, gt polecat abandon) on the
# push remote points at the commit, as mergeproof.RemoteTips.Archived. An
# unreadable remote is "not archived" (fail closed).
push_remote="${2:-${1:-origin}}"
tip_archived() {
  local sha="$1" refs
  [[ -n "$sha" && "$push_remote" != -* ]] || return 1
  refs=$(git ls-remote --refs -- "$push_remote" 'refs/gt/archive/*' 2>/dev/null) || return 1
  awk -v s="$sha" 'tolower($1) == tolower(s) && $2 ~ /^refs\/gt\/archive\// { found = 1 } END { exit !found }' <<< "$refs"
}

zero=0000000000000000000000000000000000000000
input=$(cat)

# Allowed patterns:
#   <default_branch>, beads-sync  - Direct work branches
#   polecat/*                     - Polecat working branches (Refinery merges these)
#   integration/*                 - Integration branches (created by gt mq integration)

while read local_ref local_sha remote_ref remote_sha; do
  [[ -z "$remote_ref" ]] && continue

  # Skip tags - they're allowed for releases. Archive refs (refs/gt/archive/*,
  # gt polecat abandon) are checked by the coordinator rules below.
  if [[ "$remote_ref" == refs/tags/* || "$remote_ref" == refs/gt/archive/* ]]; then
    continue
  fi

  branch="${remote_ref#refs/heads/}"

  # HEAD-mismatch guard: refuse pushing a branch you are not standing on.
  # `git push origin <B>` pushes the local <B> ref regardless of where HEAD is, so
  # running it from a session/feature branch silently no-ops ("Everything up-to-date")
  # or pushes a stale ref — the work is stranded on a branch nobody merges. Git's
  # conflict model can't catch this: it happens before any divergence exists.
  # Only fires when a local branch ref is being pushed (not HEAD:x, tags, or deletes).
  # Override for intentional cross-branch pushes: GT_ALLOW_OFFBRANCH_PUSH=1
  if [[ "${GT_ALLOW_OFFBRANCH_PUSH:-0}" != "1" \
        && "$local_ref" == refs/heads/* \
        && "$local_sha" != "$zero" ]]; then
    head_branch=$(git symbolic-ref --short -q HEAD || echo "")
    pushed_branch="${local_ref#refs/heads/}"
    if [[ -n "$head_branch" && "$head_branch" != "$pushed_branch" ]]; then
      echo "BLOCKED: pushing '$pushed_branch' while HEAD is on '$head_branch'."
      echo ""
      echo "You are not on the branch you are pushing. This commonly no-ops silently"
      echo "(\"Everything up-to-date\") or pushes a stale ref, leaving the real work"
      echo "stranded on a branch nobody merges."
      echo ""
      echo "  Check:  git status -sb ; git reflog | head"
      echo "  Fix:    git switch '$pushed_branch'   (then re-push)"
      echo "  Intentional cross-branch push? re-run with GT_ALLOW_OFFBRANCH_PUSH=1"
      exit 1
    fi
  fi

  case "$branch" in
    "${default_branch}"|beads-sync|polecat/*|integration/*)
      # Allowed branches
      ;;
    *)
      # Allow feature branches when contributing to upstream (fork workflow).
      # If an 'upstream' remote exists, this is a contribution setup where
      # feature branches are needed for PRs. See: #848
      if ! git remote get-url upstream &>/dev/null; then
        echo "ERROR: Invalid branch for Gas Town agents."
        echo ""
        echo "Blocked push to: $branch"
        echo ""
        echo "Allowed branches:"
        echo "  ${default_branch}        - Crew workers push here directly"
        echo "  polecat/*   - Polecat working branches"
        echo "  integration/* - Integration branches"
        echo "  beads-sync  - Beads synchronization"
        echo ""
        echo "Do NOT create PRs. Push to main or let Refinery merge polecat work."
        exit 1
      fi
      ;;
  esac
done <<< "$input"

# Integration landing + merge scope: delegate to the Go guard when available.
if command -v gt >/dev/null 2>&1 && gt hooks pre-push --help >/dev/null 2>&1; then
  if [[ -n "$input" ]]; then
    printf '%s\n' "$input" | gt hooks pre-push "$@" || exit 1
  fi
  exit 0
fi

# Fallback (no gt with `hooks pre-push` on PATH): integration landing guardrail.
# When pushing to the default branch, check if any integration branch tip is
# newly reachable from this push. This catches merges (--no-ff, --ff-only,
# default) and rebases. Only cherry-picks (new SHAs) are not detected — Layer 1
# covers those. GT_INTEGRATION_LAND=1 (set by gt mq integration land) skips the
# check for humans only; agents cannot land through this fallback at all.
while read local_ref local_sha remote_ref remote_sha; do
  [[ -z "$remote_ref" ]] && continue
  # Archive refs (gt-pd1c.78 tahap 2): agents never delete or rewrite them
  # (pruning is for a human or crew), and without gt the merge queue cannot
  # say whether the work may be abandoned, so they may not create them either.
  if [[ "$is_exempt" == "0" && "$remote_ref" == refs/gt/archive/* ]]; then
    echo "BLOCKED: agents may not create, delete or rewrite archive ref $remote_ref without gt"
    echo "(no gt with 'hooks pre-push' on PATH). Archives are created by 'gt polecat abandon';"
    echo "pruning them is for a human or crew."
    exit 1
  fi
  branch="${remote_ref#refs/heads/}"
  # Without gt the merge queue cannot be read, so the polecat branch deletion
  # rule cannot be proven: agents other than crew may not delete polecat/*
  # unless its tip is archived (refs/gt/archive/*) on the remote.
  if [[ "$is_exempt" == "0" && "$local_sha" == "$zero" && "$branch" == polecat/* ]] && ! tip_archived "$remote_sha"; then
    echo "BLOCKED: agents may not delete $branch without gt (no gt with 'hooks pre-push' on PATH):"
    echo "the merge queue cannot be read to prove its work is safe to discard, and its tip is not archived."
    echo "Landed polecat branches are deleted by the refinery or 'gt mq post-merge', preserved ones by"
    echo "'gt polecat prune --remote', rejected or superseded work by 'gt polecat abandon';"
    echo "anything else is reworked or resubmitted (the mayor decides) or needs a human or crew."
    exit 1
  fi
  # A rewrite (not a fast-forward) of polecat/* by an agent other than crew,
  # the refinery and the owning polecat discards the old tip like a deletion
  # (gt-pd1c.78 round 1, H1); without gt it cannot be proven safe unless the
  # old tip is archived.
  if [[ "$is_exempt" == "0" && "$caller_role" != "refinery" && "$branch" == polecat/* && \
        "$local_sha" != "$zero" && "$remote_sha" != "$zero" ]] && ! owns_branch "$branch" && ! tip_archived "$remote_sha"; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "BLOCKED: agent rewrite (not a fast-forward) of $branch, a polecat branch it does not own"
      echo "(no gt with 'hooks pre-push' on PATH): the old tip cannot be proven safe to discard."
      exit 1
    fi
  fi
  # Only the refinery, crew and humans update merge targets. Without gt the
  # rig's merge-queue setting cannot be read, so a polecat's direct landing is
  # refused too.
  if [[ "$is_exempt" == "0" && "$caller_role" != "refinery" && "$local_sha" != "$zero" && \
        ( "$branch" == "$default_branch" || "$branch" == integration/* ) ]]; then
    echo "BLOCKED: push to $branch refused: agent role '${caller_role}' may not update the default branch"
    echo "or integration/* (no gt with 'hooks pre-push' on PATH). Only the refinery lands work there;"
    echo "crew and humans push directly."
    exit 1
  fi
  # Agents may not delete merge targets here: deleting integration/x first
  # would hide a later land from the check below.
  if [[ "$is_agent" == "1" && "$local_sha" == "$zero" && \
        ( "$branch" == "$default_branch" || "$branch" == integration/* ) ]]; then
    echo "BLOCKED: agents may not delete $branch (no gt with 'hooks pre-push' on PATH)."
    exit 1
  fi
  # Agents may not rewrite or rewind merge targets: rewinding integration/x
  # onto the default branch would hide its old tip from the land check.
  if [[ "$is_agent" == "1" && "$local_sha" != "$zero" && "$remote_sha" != "$zero" && \
        ( "$branch" == "$default_branch" || "$branch" == integration/* ) ]]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "BLOCKED: push to $branch is not a fast-forward (or the remote tip is unknown locally; fetch first)."
      echo "Agents may not rewrite or rewind merge target branches."
      exit 1
    fi
  fi
  [[ "$branch" == "$default_branch" ]] || continue
  if [[ "$is_agent" == "0" && "$GT_INTEGRATION_LAND" == "1" ]]; then
    continue
  fi
  # Skip for deletions or initial pushes
  if [[ "$remote_sha" == "$zero" ]] || [[ "$local_sha" == "$zero" ]]; then
    continue
  fi
  # Use ls-remote instead of for-each-ref to avoid false positives from stale
  # local tracking refs that may linger after branch deletion.
  # Fail closed: if ls-remote fails (network error), block the push rather than
  # silently allowing unverified integration branch content through.
  integration_refs=$(git ls-remote --quiet origin "refs/heads/integration/*" 2>&1) || {
    echo "WARNING: Cannot verify integration branches (remote unreachable)."
    echo "Push to $default_branch blocked. Retry when network is available."
    if [[ "$is_agent" == "0" ]]; then
      echo "For an intentional land, GT_INTEGRATION_LAND=1 skips this check."
    fi
    exit 1
  }
  for ref in $(echo "$integration_refs" | awk '{print $1}'); do
    if git merge-base --is-ancestor "$ref" "$local_sha" 2>/dev/null && \
       ! git merge-base --is-ancestor "$ref" "$remote_sha" 2>/dev/null; then
      echo "BLOCKED: Push to $default_branch introduces integration branch content."
      echo ""
      if [[ "$is_agent" == "1" ]]; then
        echo "Agents may not land integration branches from this hook."
        echo "A human must run: gt mq integration land <epic-id>"
      else
        echo "Integration branches must be landed via: gt mq integration land <epic-id>"
        echo ""
        echo "This guardrail prevents accidental landing of integration branches."
        echo "The gt mq integration land command sets GT_INTEGRATION_LAND=1 to bypass this check."
      fi
      exit 1
    fi
  done
done <<< "$input"

exit 0
